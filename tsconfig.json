{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2022",
		"lib": [ "ES2022" ],
		"rootDir": "src",
		"strict": true,   /* enable all strict type-checking options */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [ "node" ],
		/* 산출물은 esbuild가 소유한다. tsc는 타입체커 전용 (npm run typecheck) */
		"noEmit": true
	},
	/* webview 코드는 DOM lib이 필요해 tsconfig.webview.json이 따로 컴파일한다 */
	"exclude": [ "src/webview" ]
}
